# Documents all environment variables used by the pipeline (design.md §17).
# No secrets are required for the core pipeline.

# Path to the pipeline config file; overrides the default for multi-config experiments.
CONFIG_PATH=config.yaml

# Path to the BirdNET V2.4 model weights (downloaded by scripts/bootstrap.sh, not committed).
BIRDNET_MODEL_PATH=models/BirdNET_GLOBAL_6K_V2.4_Model_FP32.tflite

# Root of the data directory tree.
DATA_DIR=data/

# Root of the model artifacts directory.
ARTIFACTS_DIR=artifacts/

# Root of the inference routing output directory.
OUTPUTS_DIR=outputs/

# Global random seed for reproducible splits and training.
RANDOM_SEED=42

# Python logging level (DEBUG for verbose training output).
LOG_LEVEL=INFO
